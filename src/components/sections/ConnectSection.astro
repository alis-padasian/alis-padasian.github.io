---
import { getPublicAnnouncements } from "../../lib/announcements";

const announcements = (await getPublicAnnouncements()).slice(0, 3);

const typeLabels: Record<string, string> = {
  release: "New Release",
  update: "Series Update",
  "exclusive-content": "Exclusive Content",
};

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<div class="space-y-8 sm:space-y-10">
  <header class="border-b border-paper-300/90 pb-6 dark:border-ink-700">
    <h2 class="text-3xl font-semibold tracking-tight text-ink-950 dark:text-paper-50 sm:text-4xl">
      The Next Chapter
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-ink-700 dark:text-paper-300">
      Release announcements, early excerpts, and notes for readers who want to stay on the shore.
    </p>
    <a href="/connect" class="action-link mt-4 inline-flex px-0 text-sm font-semibold">
      Join the reader dispatch
      <span class="i-mdi:arrow-right text-base" aria-hidden="true"></span>
    </a>
  </header>

  {announcements.length === 0 ? (
    <div class="surface-card rounded-xl border border-paper-300/80 p-8 text-center dark:border-ink-700">
      <p class="text-sm text-ink-700 dark:text-paper-300">
        The next dispatch is being written. Release news will appear here the moment it is ready.
      </p>
    </div>
  ) : (
    <ol class="m-0 list-none space-y-4 p-0">
      {announcements.map((announcement) => (
        <li class="surface-card rounded-xl border border-paper-300/80 p-5 dark:border-ink-700">
          <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-ink-600 dark:text-paper-400">
            <span class="rounded bg-accent-100/70 px-2 py-0.5 font-semibold text-accent-800 dark:bg-accent-950/60 dark:text-accent-300">
              {typeLabels[announcement.data.type] ?? announcement.data.type}
            </span>
            <time datetime={announcement.data.publishedAt.toISOString()}>
              {formatDate(announcement.data.publishedAt)}
            </time>
          </div>
          <h3 class="mt-2 text-lg font-semibold text-ink-950 dark:text-paper-50">
            {announcement.data.title}
          </h3>
          <p class="mt-1 text-sm text-ink-700 dark:text-paper-300">
            {announcement.data.description}
          </p>
        </li>
      ))}
    </ol>
  )}
</div>
